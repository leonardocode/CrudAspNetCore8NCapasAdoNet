@model CapaEntidades.Contacto
@{
    ViewData["Title"] = "Detalle Contacto";
}

<div class="row">
    <div class="offset-12">
        <div class="card border">
            <div class="card-header bg-dark">
                <h3 class="text-white"><strong>Detalle Contacto</strong></h3>
            </div>
            <div class="card-body">
                <ul class="list-group">
                    <li class="list-group-item"><strong>Nombre:</strong> @Html.DisplayFor(m => m.Nombre)</li>
                    <li class="list-group-item"><strong>Celular:</strong> @Html.DisplayFor(m => m.Celular)</li>
                    <li class="list-group-item"><strong>Email:</strong> @Html.DisplayFor(m => m.Email)</li>
                </ul>
                
                <a class="btn btn-danger mt-3" type="button" asp-controller="Contacto" asp-action="Index">Volver</a>
            </div>
        </div>
    </div>
</div>

